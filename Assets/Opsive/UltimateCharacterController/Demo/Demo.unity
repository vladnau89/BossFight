  m_NoZoneTitle: '{AssetName} Demo'
  m_NoZoneDescription: "\rUse the arrows to teleport to different zones.\r\n\r\nPress
    Escape to show the cursor.\nPress Escape again to show the controls."
  m_AddOnDemoManager: 0
  m_DefaultFirstPersonStart: 1
